# SSO Configuration
SSO_USERNAME=your.email@company.com
SSO_PASSWORD=your-password-here

# Target Application Configuration
APP_URL=https://your-application.example.com

# Data Source Configuration
# Options: excel (default) or sharepoint
DATA_SOURCE=excel

# Excel File Path (if using Excel as data source)
EXCEL_FILE_PATH=./data/sample_records.xlsx

# Optional: External API Configuration
# API_URL=https://api.example.com
# API_TOKEN=your-api-token-here

# Optional: SharePoint Configuration (if using SharePoint as data source)
# SHAREPOINT_SITE_URL=https://your-company.sharepoint.com/sites/yoursite
# SHAREPOINT_LIST_NAME=your-list-name
# SHAREPOINT_CLIENT_ID=your-client-id
# SHAREPOINT_CLIENT_SECRET=your-client-secret
# SHAREPOINT_TENANT_ID=your-tenant-id

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=2

# Browser Configuration
BROWSER_HEADLESS=True   # Set to False to see the browser during execution
BROWSER_TIMEOUT=30
CLOSE_BROWSER_AFTER_TEST=True  # Set to False to keep browser open for debugging

# Logging
LOG_LEVEL=INFO
